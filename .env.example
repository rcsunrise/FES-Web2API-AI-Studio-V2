# ---------------- Control Plane ----------------
PORT=8787
FES_API_KEY=
BROWSER_WORKER_URL=http://127.0.0.1:9797
WORKER_SHARED_SECRET=change-this-secret

# ---------------- Browser Worker ----------------
WORKER_PORT=9797
WORKER_HOST=0.0.0.0
WORKER_SHARED_SECRET=change-this-secret

# true = background execution after login; false = keep browser visible for debugging
WORKER_HEADLESS=true

# IMPORTANT:
# Login/verification always launches a visible browser window on the machine running Browser Worker.
# Therefore for V1/V2, run Browser Worker on your own PC/VM with a desktop session.
WORKER_PUBLIC_BASE_URL=http://127.0.0.1:9797
WORKER_DATA_DIR=./worker-data
